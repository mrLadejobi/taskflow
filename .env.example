# TaskFlow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application settings
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database (SQLite connection string)
DATABASE_URL=sqlite:///./taskflow.db

# Security & Authentication
# Required in production: generate a 32+ character random secret
SECRET_KEY=change-me-in-production-use-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
